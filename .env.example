# Copy to .env; never commit the real .env file.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=esp32_monitor
MQTT_PASSWORD=REPLACE_ME

# Grafana operator control API (local use)
CONTROL_USERNAME=operator
CONTROL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
CONTROL_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
CONTROL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=

# Microsoft Azure Table Storage
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_YOUR_AZURE_CONNECTION_STRING
AZURE_TABLE_NAME=REPLACE_WITH_YOUR_AZURE_TABLE_NAME

# Never commit real Azure credentials or connection strings.
